<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="MainLoop">
  <BehaviorTree ID="CaptureCenterArea">
    <WhileDoElse>
      <ShouldEngage enemy_count="{enemy_count}"
                    ammo="{ammo}"/>
      <Attack ammo="{ammo}"
              enemy_count="{enemy_count}"/>
      <SubTree ID="NavigateAndTrigger"
               goal_x="2.0"
               goal_y="2.0"
               rfid="{rfid_center}"
               hold="true"
               _autoremap="true"/>
    </WhileDoElse>
  </BehaviorTree>

  <BehaviorTree ID="Decide">
    <WhileDoElse>
      <SubTree ID="IsSafe"
               _autoremap="true"/>
      <SubTree ID="CaptureCenterArea"
               _autoremap="true"/>
      <SubTree ID="FallBack"
               _autoremap="true"/>
    </WhileDoElse>
  </BehaviorTree>

  <BehaviorTree ID="FallBack">
    <!-- 回补给区：判补给区卡（rfid_supply）。UL 规则 3.3.2.1 是"占领己方补给区
         回血"，场地里没有基地增益点这个概念。到了就钉住（hold=true）——压在补给区
         卡上本身就在回血，钉住期间速度被置零开关压着，手柄也推不动它。
         切换过来的那一轮人还在控制区上，rfid_supply 为假，会走共享子树里"还没
         到位"那支先放开开关，所以"IsSafe 切换时放开"是自动发生的，不用另写。
         坐标还是占位值，等补给区实际坐标定下来改这两行。 -->
    <SubTree ID="NavigateAndTrigger"
             goal_x="0.0"
             goal_y="0.0"
             rfid="{rfid_supply}"
             hold="true"
             _autoremap="true"/>
  </BehaviorTree>

  <BehaviorTree ID="IsSafe">
    <CheckHpSafe HP="{HP}"
                 enter_hp="200.0"
                 exit_hp="400.0"/>
  </BehaviorTree>

  <BehaviorTree ID="MainLoop">
    <ReactiveSequence>
      <Ros2Input HP="{HP}"
                 maximum_hp="{maximum_hp}"
                 ammo="{ammo}"
                 heat="{heat}"
                 heat_limit="{heat_limit}"
                 cooling_value="{cooling_value}"
                 hp_deduced="{hp_deduced}"
                 enemy_count="{enemy_count}"
                 game_progress="{game_progress}"
                 stage_remain_time="{stage_remain_time}"
                 rfid_supply="{rfid_supply}"
                 rfid_center="{rfid_center}"
                 robot_x="{robot_x}"
                 robot_y="{robot_y}"
                 robot_yaw="{robot_yaw}"
                 pose_valid="{pose_valid}"
                 robot_status_received="{robot_status_received}"
                 game_status_received="{game_status_received}"
                 rfid_status_received="{rfid_status_received}"
                 vision_received="{vision_received}"/>
      <PublishStop/>
      <!-- 赛前开关：比赛阶段连续为"比赛中"满 1 秒才放行，之前整棵树不动，
           只有 Ros2Input 与 PublishStop 照常跑（数据要刷新、开关要维持）。 -->
      <IsGameStart game_progress="{game_progress}"
                   hold_sec="1.0"/>
      <SubTree ID="Decide"
               _autoremap="true"/>
    </ReactiveSequence>
  </BehaviorTree>

  <BehaviorTree ID="NavigateAndTrigger">
    <ReactiveFallback>
      <Sequence>
        <RfidArrived rfid="{rfid}"/>
        <SetStop stop="{hold}"/>
      </Sequence>
      <Sequence>
        <SetStop stop="false"/>
        <SetGoalPose pose_x="{goal_x}"
                     pose_y="{goal_y}"/>
        <ReactiveFallback>
          <Sequence>
            <AchieveGoalPose/>
            <SubTree ID="SearchRfid"
                     rfid="{rfid}"
                     _autoremap="true"/>
          </Sequence>
          <PublishGoal/>
        </ReactiveFallback>
      </Sequence>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="SearchRfid">
    <ReactiveFallback>
      <RfidArrived rfid="{rfid}"/>
      <Patrol xs="0.25;0.25;-0.25;-0.25"
              ys="0.25;-0.25;-0.25;0.25"
              tolerance="0.20"
              timeout="4.0"
              max_rounds="0"/>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="AchieveGoalPose"
               editable="true"/>
    <Action ID="Attack"
            editable="true">
      <input_port name="ammo"
                  default="100"
                  type="int"/>
      <input_port name="enemy_count"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="CheckHpSafe"
            editable="true">
      <input_port name="HP"
                  default="200"
                  type="double"/>
      <input_port name="enter_hp"
                  default="200.0"
                  type="double"/>
      <input_port name="exit_hp"
                  default="400.0"
                  type="double"/>
    </Action>
    <SubTree ID="NavigateAndTrigger">
      <input_port name="goal_x"
                  type="double"/>
      <input_port name="goal_y"
                  type="double"/>
      <input_port name="rfid"
                  type="bool"/>
      <input_port name="hold"
                  type="bool"/>
    </SubTree>
    <Action ID="Patrol"
            editable="true">
      <input_port name="xs"
                  default="0.25;0.25;-0.25;-0.25"
                  type="std::vector&lt;double&gt;"/>
      <input_port name="ys"
                  default="0.25;-0.25;-0.25;0.25"
                  type="std::vector&lt;double&gt;"/>
      <input_port name="tolerance"
                  default="0.20"
                  type="double"/>
      <input_port name="timeout"
                  default="4.0"
                  type="double"/>
      <input_port name="max_rounds"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="PublishGoal"
            editable="true"/>
    <Action ID="IsGameStart"
            editable="true">
      <input_port name="game_progress"
                  default="4"
                  type="int"/>
      <input_port name="hold_sec"
                  default="1.0"
                  type="double"/>
    </Action>
    <Action ID="PublishStop"
            editable="true"/>
    <Action ID="Ros2Input"
            editable="true">
      <output_port name="HP"
                   type="double"/>
      <output_port name="maximum_hp"
                   type="double"/>
      <output_port name="ammo"
                   type="int"/>
      <output_port name="heat"
                   type="int"/>
      <output_port name="heat_limit"
                   type="int"/>
      <output_port name="cooling_value"
                   type="int"/>
      <output_port name="hp_deduced"
                   type="bool"/>
      <output_port name="enemy_count"
                   type="int"/>
      <output_port name="game_progress"
                   type="int"/>
      <output_port name="stage_remain_time"
                   type="int"/>
      <output_port name="rfid_supply"
                   type="bool"/>
      <output_port name="rfid_center"
                   type="bool"/>
      <output_port name="robot_x"
                   type="double"/>
      <output_port name="robot_y"
                   type="double"/>
      <output_port name="robot_yaw"
                   type="double"/>
      <output_port name="pose_valid"
                   type="bool"/>
      <output_port name="robot_status_received"
                   type="bool"/>
      <output_port name="game_status_received"
                   type="bool"/>
      <output_port name="rfid_status_received"
                   type="bool"/>
      <output_port name="vision_received"
                   type="bool"/>
    </Action>
    <Condition ID="RfidArrived"
               editable="true">
      <input_port name="rfid"
                  default="false"
                  type="bool"/>
    </Condition>
    <SubTree ID="SearchRfid">
      <input_port name="rfid"
                  type="bool"/>
    </SubTree>
    <Action ID="SetGoalPose"
            editable="true">
      <input_port name="pose_x"
                  default="0.0"
                  type="double"/>
      <input_port name="pose_y"
                  default="0.0"
                  type="double"/>
    </Action>
    <Action ID="SetStop"
            editable="true">
      <input_port name="stop"
                  default="true"
                  type="bool"/>
    </Action>
    <Condition ID="ShouldEngage"
               editable="true">
      <input_port name="enemy_count"
                  default="0"
                  type="int"/>
      <input_port name="ammo"
                  default="100"
                  type="int"/>
    </Condition>
  </TreeNodesModel>

</root>
