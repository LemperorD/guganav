<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Main">
    <KeepRunningUntilFailure>
      <ForceSuccess>
        <Sequence>
          <Ros2Input HP="{HP}"
                     ammo="{ammo}"
                     game_progress="{game_progress}"
                     robot_x="{robot_x}"
                     robot_y="{robot_y}"
                     pose_valid="{pose_valid}"/>
          <IsGameStart game_progress="{game_progress}"/>
          <SubTree ID="SwitchState"
                   _autoremap="true"/>
          <Switch3 case_1="Suppress"
                   case_2="Occupation"
                   case_3="PushForward"
                   variable="{global_state_}">
            <SubTree ID="Suppress"
                     _autoremap="true"/>
            <SubTree ID="Occupation"
                     _autoremap="true"/>
            <SubTree ID="PushForward"
                     _autoremap="true"/>
          </Switch3>
        </Sequence>
      </ForceSuccess>
    </KeepRunningUntilFailure>
  </BehaviorTree>

  <BehaviorTree ID="Occupation">
    <Sequence>
      <CheckHP HP="{HP}"
               strategy_mode="{global_state_}"
               destination="{destination}"/>
      <GotoPoints destination="{destination}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PushForward">
    <Fallback>
      <Sequence>
        <CheckHP HP="{HP}"
                 strategy_mode="{global_state_}"
                 destination="{destination}"/>
        <GotoPoints destination="{destination}"/>
      </Sequence>
      <Sequence>
        <CheckTime stay_time="{stay_time}"
                   destination="{destination}"/>
        <GotoPoints destination="{destination}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="Suppress">
    <Sequence>
      <CheckHP HP="{HP}"
               strategy_mode="{global_state_}"
               destination="{destination}"/>
      <GotoPoints destination="{destination}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SwitchState">
    <Fallback>
      <Sequence>
        <IsRevivedAndDead HP="{HP}"
                          HP_sign="{HP_sign}"/>
        <ChangeLowerState global_state_="{global_state_}"/>
      </Sequence>
      <Sequence>
        <IsOccupationsafe destination="{destination}"
                          occupation_time="{occupation_time}"/>
        <ChangeHigherState global_state_="{global_state_}"/>
      </Sequence>
    </Fallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ChangeHigherState"
            editable="true">
      <inout_port name="global_state_"
                  type="string"/>
    </Action>
    <Action ID="ChangeLowerState"
            editable="true">
      <inout_port name="global_state_"
                  type="string"/>
    </Action>
    <Condition ID="CheckHP"
               editable="true">
      <input_port name="HP"
                  type="double"/>
      <output_port name="destination"
                   type="int"/>
      <input_port name="strategy_mode"
                  type="string"/>
    </Condition>
    <Condition ID="CheckTime"
               editable="true">
      <inout_port name="destination"
                  type="int"/>
      <inout_port name="stay_time"
                  type="double"/>
    </Condition>
    <Action ID="GotoPoints"
            editable="true">
      <input_port name="destination"
                  type="int"/>
    </Action>
    <Condition ID="IsGameStart"
               editable="true">
      <input_port name="game_progress"
                  type="int"/>
    </Condition>
    <Condition ID="IsOccupationsafe"
               editable="true">
      <input_port name="destination"
                  type="int"/>
      <inout_port name="occupation_time"
                  type="double"/>
    </Condition>
    <Condition ID="IsRevivedAndDead"
               editable="true">
      <input_port name="HP"
                  type="double"/>
      <inout_port name="HP_sign"
                  type="int"/>
    </Condition>
    <Action ID="Ros2Input"
            editable="true">
      <output_port name="HP"
                   type="double"/>
      <output_port name="ammo"
                   type="int"/>
      <output_port name="game_progress"
                   type="int"/>
      <output_port name="robot_x"
                   type="double"/>
      <output_port name="robot_y"
                   type="double"/>
      <output_port name="pose_valid"
                   type="bool"/>
    </Action>
  </TreeNodesModel>

</root>
