[Unit]
Description=Sentry Nav Auto Launch Service
# 需要图形界面（rviz2）：挂在 graphical.target 下，且晚于显示管理器启动，
# 否则开机时 DISPLAY=:0 还不存在，rviz2 会直接退出。
After=network-online.target display-manager.service
Wants=network-online.target
# 启动失败时最多重试 3 次（120s 内），避免旧版那样每 5s 无限重启。
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=sentry-nav
WorkingDirectory=/home/sentry-nav/guganav
Environment="DISPLAY=:0"
Environment="XAUTHORITY=/home/sentry-nav/.Xauthority"

# 自动登录后 Xauthority 才可用，这里最多等 60s 直到 :0 真正可连；
# 等不到也继续启动，保证导航能起来（只是 rviz2 会失败）。
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do xdpyinfo >/dev/null 2>&1 && exit 0; sleep 1; done; echo "DISPLAY=:0 未就绪，跳过等待继续启动" >&2; exit 0'

# 直接执行入口脚本，不要再用 bash -c "... \n \n" 包一层：
# 菜单只有在有 /dev/tty 时才会出现，systemd 下 stdin 是 /dev/null，
# 那两个回车既不起作用，写成 \n 还会被 systemd 当成转义字符。
ExecStart=/home/sentry-nav/guganav/scripts/reality.sh n room_207 planner:=jps controller:=mppi

Restart=on-failure
RestartSec=5s
# SIGTERM 先只发给脚本，让 trap 里的清理逻辑跑完，超时后再 SIGKILL 整个 cgroup。
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=graphical.target
