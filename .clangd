CompileFlags:
  CompilationDatabase: build
  Add:
    - -xc++
    - -std=gnu++20
    - --gcc-install-dir=/usr/lib/gcc/x86_64-linux-gnu/11
    - -I/home/rog/guganav/.cache/clangd-include  # 内含 omp.h(系统 GCC 头目录 clangd 找不到);
    # 若 .cache 被清空,重新执行:
    #   mkdir -p .cache/clangd-include && cp /usr/lib/gcc/x86_64-linux-gnu/11/include/omp.h .cache/clangd-include/

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - system-include
    - system-include-angle
  ClangTidy:
    Add:
      - "*"
    Remove:
      - bugprone-easily-swappable-parameters
      - cppcoreguidelines-owning-memory
      - cppcoreguidelines-pro-bounds-pointer-arithmetic
      - cppcoreguidelines-pro-bounds-constant-array-index
      - cppcoreguidelines-pro-type-reinterpret-cast
      - hicpp-signed-bitwise
      - misc-unused-parameters
      - performance-unnecessary-value-param
      - readability-function-cognitive-complexity
      - readability-magic-numbers
      - cppcoreguidelines-avoid-magic-numbers
      - readability-identifier-length
      - llvm*
      - llvmlibc*
      - abseil*
      - android*
      - fuchsia*
      - objc*
      - zircon*
      - altera*
      - google*
      - boost-*
      - modernize-use-trailing-return-type

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes

Completion:
  AllScopes: Yes

Hover:
  ShowAKA: Yes
